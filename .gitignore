# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/

# uv
.uv-cache/

# Tooling
.mypy_cache/
.ruff_cache/
.pytest_cache/
.coverage
htmlcov/
.codegraph/

# Editors
.idea/
.vscode/
*.swp
.DS_Store

# Env
.env
.env.local
*.local

# Runtime
var/
!var/.gitkeep
logs/
*.log

# uv lock kept; pip-tools artifacts ignored
requirements*.txt

# NT runtime artifacts
.nautilus/
catalog/

# Claude Code local settings (per-user permission allowlist)
.claude/settings.local.json

# User strategies — only the example template is tracked. Everything else
# under strategies/ is treated as private (alpha logic, venue-baked params,
# etc.) and stays local. Force-add with ``git add -f`` if you really want
# to commit one.
strategies/*
!strategies/__init__.py
!strategies/example/
