-
-// 最新一笔 fill 覆盖显示，fade 过渡
-// 无 fill 时隐藏该区域
-
-interface TickerState {
-  text: string;        // "BTC +0.5 @ 67,120"
-  side: 'buy' | 'sell';
-  timestamp: number;
-}
-
-// 行为：
-// 1. 新 fill 进来 → 更新 state → fade out 旧文本 → fade in 新文本 (200ms)
-// 2. 5 秒无新 fill → fade out → 区域折叠
-// 3. 点击 → router.push('/trading?tab=orders')
