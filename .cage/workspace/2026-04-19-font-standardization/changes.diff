-/* === COUNTER === */
-function animC(el){const target=parseFloat(el.dataset.count),decimal=parseInt(el.dataset.decimal||'0'),prefix=el.dataset.prefix||'',suffix=el.dataset.suffix||'',comma=el.hasAttribute('data-comma'),dur=1400,start=performance.now();function tick(now){const t=Math.min((now-start)/dur,1),eased=1-Math.pow(1-t,3);let val=(target*eased).toFixed(decimal);if(comma)val=Number(val).toLocaleString('en-US',{minimumFractionDigits:decimal,maximumFractionDigits:decimal});el.textContent=prefix+val+suffix;if(t<1)requestAnimationFrame(tick)}requestAnimationFrame(tick)}
