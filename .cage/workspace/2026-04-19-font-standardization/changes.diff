-<script>
-/* ===== DATA ===== */
-const allSymbols=['BTCUSDT','ETHUSDT','SOLUSDT','ARBUSDT','DOGEUSDT','LINKUSDT','AVAXUSDT','OPUSDT','APTUSDT','MATICUSDT','DOTUSDT','ATOMUSDT','NEARUSDT','FTMUSDT','RUNEUSDT'];
-const dataTypes=['klines','indexPriceKlines','markPriceKlines','premiumIndexKlines','aggTrades','trades','fundingRate'];
-const typeLabels={klines:'klines',indexPriceKlines:'indexPriceKlines',markPriceKlines:'markPriceKlines',premiumIndexKlines:'premiumIndexKlines',aggTrades:'aggTrades',trades:'trades',fundingRate:'fundingRate'};
-const typeCls={klines:'type-kl',indexPriceKlines:'type-ipk',markPriceKlines:'type-mpk',premiumIndexKlines:'type-pik',aggTrades:'type-at',trades:'type-tr',fundingRate:'type-fr'};
-const klineTypes=['klines','indexPriceKlines','markPriceKlines','premiumIndexKlines'];
-const intervals=['1m','5m','15m','1h','4h','1d'];
-
-const catalog=[];
-for(let i=0;i<60;i++){
-  const sym=allSymbols[i%allSymbols.length];
-  const dt=dataTypes[i%7];
-  const isKline=klineTypes.includes(dt);
-  const intv=isKline?intervals[i%6]:'—';
-  const records=Math.floor(Math.random()*5000000+100000);
-  const startD=new Date(2025,Math.floor(Math.random()*6),1+Math.floor(Math.random()*28));
-  const endD=new Date(2026,2+Math.floor(Math.random()*2),1+Math.floor(Math.random()*28));
-  const sizeM=Math.round(records/100000*(isKline?2:dt.includes('rade')?12:0.5)*10)/10;
-  catalog.push({id:i,sym,dt,intv,records,start:fmtDate(startD),end:fmtDate(endD),size:sizeM,startD,endD});
-}
-
-const queue=[
-  {sym:'BTCUSDT',dt:'klines',intv:'5m',range:'01/01 → 03/31',status:'running',pct:67,msg:'Downloading 2026-02-15...',time:'2 分钟前'},
-  {sym:'ETHUSDT',dt:'aggTrades',intv:'—',range:'02/01 → 03/15',status:'running',pct:34,msg:'Processing chunk 1240...',time:'刚刚'},
-  {sym:'SOLUSDT',dt:'markPriceKlines',intv:'15m',range:'01/01 → 03/31',status:'queued',pct:0,msg:'',time:'1 分钟前'},
-  {sym:'BTCUSDT',dt:'fundingRate',intv:'—',range:'01/01 → 03/31',status:'completed',pct:100,msg:'',time:'5 分钟前'},
-  {sym:'ARBUSDT',dt:'trades',intv:'—',range:'01/15 → 02/28',status:'failed',pct:82,msg:'Rate limit exceeded',time:'8 分钟前'},
-  {sym:'LINKUSDT',dt:'indexPriceKlines',intv:'1h',range:'01/01 → 03/31',status:'completed',pct:100,msg:'',time:'12 分钟前'},
-  {sym:'DOTUSDT',dt:'premiumIndexKlines',intv:'5m',range:'03/01 → 03/15',status:'cancelled',pct:45,msg:'',time:'20 分钟前'},
-];
-
-let dtPage=1,dtSize=20;
-let sortCol='sym',sortDir='asc';
-let selectedSymbols=[];
-let delTarget=null;
-
-function fmtDate(d){return d.getFullYear()+'-'+(d.getMonth()+1).toString().padStart(2,'0')+'-'+d.getDate().toString().padStart(2,'0')}
-
-/* ===== TABS ===== */
-let curGroup='all',curSub=null;
-const groups={
-  all:{label:'全部',dot:'var(--t1)',types:null},
-  klines:{label:'Klines',dot:'var(--info)',types:['klines','indexPriceKlines','markPriceKlines','premiumIndexKlines']},
-  trades:{label:'Trades',dot:'var(--acc)',types:['aggTrades','trades']},
-  fundingRate:{label:'Funding',dot:'var(--suc)',types:['fundingRate']},
-};
-function getFilteredTypes(){
-  if(curGroup==='all')return null;
-  const g=groups[curGroup];
-  if(curSub)return [curSub];
-  return g.types;
-}
-function renderTabs(){
-  const el=document.getElementById('filterTabs');
-  let h='';
-  for(const[key,g]of Object.entries(groups)){
-    const cnt=g.types?catalog.filter(c=>g.types.includes(c.dt)).length:catalog.length;
-    h+=`<div class="filter-item${curGroup===key?' a':''}" onclick="setGroup('${key}')"><div class="filter-dot" style="background:${g.dot}"></div>${g.label} <span class="filter-count">${cnt}</span></div>`;
-  }
-  el.innerHTML=h;
-  const sr=document.getElementById('subFilterRow');
-  const g=groups[curGroup];
-  if(g.types&&g.types.length>1){
-    let sh=`<div class="sub-filter">`;
-    sh+=`<span class="sub-item${!curSub?' a':''}" onclick="setSub(null)">全部</span>`;
-    g.types.forEach(t=>{sh+=`<span class="sub-item${curSub===t?' a':''}" onclick="setSub('${t}')">${typeLabels[t]}</span>`});
-    sh+=`</div>`;sr.innerHTML=sh;
-  } else {sr.innerHTML=''}
-}
-function setGroup(g){curGroup=g;curSub=null;dtPage=1;renderTabs();renderStats();renderTable()}
-function setSub(s){curSub=s;dtPage=1;renderTabs();renderStats();renderTable()}
-
-/* ===== STATS ===== */
-function getFiltered(){const ft=getFilteredTypes();return ft?catalog.filter(c=>ft.includes(c.dt)):[...catalog]}
-function renderStats(){
-  const filtered=getFiltered();
-  const count=filtered.length;
-  const totalRecords=filtered.reduce((s,c)=>s+c.records,0);
-  const maxDate=filtered.length?filtered.reduce((m,c)=>c.endD>m?c.endD:m,filtered[0].endD):null;
-  const totalSize=filtered.reduce((s,c)=>s+c.size,0);
-  const now=new Date();const staleD=maxDate?Math.floor((now-maxDate)/86400000):0;
-  const fc=staleD<=1?'cg':staleD<=7?'':staleD<=30?'ca':'cr';
-  const fl=staleD===0?'今天':staleD===1?'昨天':staleD+'天前';
-  document.getElementById('statsCards').innerHTML=`
-    <div class="sc"><div class="sc-l">数据集</div><div class="sc-v">${count}</div></div>
-    <div class="sc"><div class="sc-l">总记录数</div><div class="sc-v">${(totalRecords/1e6).toFixed(1)}M</div></div>
-    <div class="sc"><div class="sc-l">最新数据</div><div class="sc-v ${fc}">${maxDate?fmtDate(maxDate):'—'}</div><div class="sc-sub ${fc}">${maxDate?fl:''}</div></div>
-    <div class="sc"><div class="sc-l">磁盘占用</div><div class="sc-v">${totalSize>=1000?(totalSize/1000).toFixed(1)+' GB':totalSize.toFixed(0)+' MB'}</div></div>`;
-}
-
-/* ===== QUEUE ===== */
-function renderQueue(){
-  const active=queue.filter(q=>q.status==='running'||q.status==='queued');
-  const hist=queue.filter(q=>q.status!=='running'&&q.status!=='queued').slice(0,10);
-  const all=[...active,...hist];
-  document.getElementById('queueBadge').textContent=active.length;
-  if(all.length===0){document.getElementById('queueList').innerHTML='<div class="empty"><div class="empty-icon">⧖</div><div class="empty-text">暂无拉取任务</div></div>';return}
-  let h='';
-  all.forEach(q=>{
-    const accCls=q.status==='running'?'background:var(--info)':q.status==='completed'?'background:var(--suc)':q.status==='failed'?'background:var(--dan)':'background:var(--t3)';
-    let statusHtml='';
-    if(q.status==='running') statusHtml=`<div class="qprog"><div class="qprog-bar"><div class="qprog-fill" style="width:${q.pct}%"></div></div><span class="ca">${q.pct}%</span></div><div class="qprog-msg">${q.msg}</div>`;
-    else if(q.status==='queued') statusHtml=`<span class="status status-queue">排队中</span>`;
-    else if(q.status==='completed') statusHtml=`<span class="status status-done">✓ 完成</span>`;
-    else if(q.status==='failed') statusHtml=`<span class="status status-fail" title="${q.msg}">✕ 失败</span>`;
-    else statusHtml=`<span class="status status-cancel">已取消</span>`;
-    h+=`<div class="qrow"><div class="qrow-acc" style="${accCls}"></div><div class="qrow-info"><div class="qrow-sym">${q.sym}</div><div class="qrow-meta">${q.dt} · ${q.intv!=='—'?q.intv+' · ':''}${q.range}</div></div><div class="qrow-status">${statusHtml}</div><div class="qrow-time">${q.time}</div></div>`;
-  });
-  document.getElementById('queueList').innerHTML=h;
-}
-
-/* ===== TABLE ===== */
-function renderTable(){
-  const filtered=getFiltered();
-  filtered.sort((a,b)=>{
-    let va=a[sortCol],vb=b[sortCol];
-    if(typeof va==='string')va=va.toLowerCase();if(typeof vb==='string')vb=vb.toLowerCase();
-    if(va<vb)return sortDir==='asc'?-1:1;if(va>vb)return sortDir==='asc'?1:-1;return 0;
-  });
-  const total=filtered.length;const totalPages=Math.ceil(total/dtSize);
-  if(dtPage>totalPages)dtPage=totalPages;if(dtPage<1)dtPage=1;
-  const start=(dtPage-1)*dtSize;const slice=filtered.slice(start,start+dtSize);
-
-  const isAll=curGroup==='all';const isKlineGrp=curGroup==='klines';const isTradeGrp=curGroup==='trades';
-  const showType=isAll||(!curSub&&(isKlineGrp||isTradeGrp));
-  const recLabel=isKlineGrp?'Bars':isTradeGrp?'Ticks':'记录数';
-  const cols=[
-    {key:'sym',label:'品种',right:false,show:true},
-    {key:'dt',label:'类型',right:false,show:showType},
