-function renderAll(){
-  const running=activeTasks.filter(t=>t.status==='running').length;
-  const queued=activeTasks.filter(t=>t.status==='queued').length;
-  const done=history.filter(t=>t.status==='done').length;
-  const failed=history.filter(t=>t.status==='failed').length;
-  document.getElementById('totalCount').textContent=(activeTasks.length+history.length)+' 个回测任务';
-  document.getElementById('summaryStrip').innerHTML=
-    `<div class="summary-item"><div class="summary-dot" style="background:var(--info)"></div><span style="color:var(--info)">${running} Running</span></div>`+
-    `<div class="summary-item"><div class="summary-dot" style="background:var(--suc)"></div><span class="cg">${done} Done</span></div>`+
-    `<div class="summary-item"><div class="summary-dot" style="background:var(--dan)"></div><span class="cr">${failed} Failed</span></div>`+
-    `<div class="summary-item"><div class="summary-dot" style="background:var(--t3)"></div><span>${queued} Queued</span></div>`;
-  renderActive();renderHistory();
-}
