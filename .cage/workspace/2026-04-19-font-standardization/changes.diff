-<script>
-/* ===== DATA ===== */
-const strats=['MM-perp v3.2','Stat-arb v1.8','Funding arb v2.0','Basis v0.9','Momentum v4.1','Grid v0.3','Pairs v0.1','TWAP v1.0','Liq-hunter v0.2'];
-const exs=['Binance','Hyperliquid','OKX'];
-const tfs=['1min','5min','15min','1h'];
-function rid(){return Array.from({length:8},()=>'0123456789abcdef'[Math.floor(Math.random()*16)]).join('')}
-function rfull(){return rid()+'-'+rid().substring(0,4)+'-'+rid().substring(0,4)+'-'+rid().substring(0,4)+'-'+rid()+rid().substring(0,4)}
-
-const activeTasks=[
-  {id:'r1',num:'0401',strat:'MM-perp v3.2',status:'running',tf:'15min',ex:'Binance',range:'03/01 → 03/31',uuid:rfull(),pct:67},
-  {id:'r2',num:'0402',strat:'Stat-arb v1.8',status:'running',tf:'1min',ex:'Hyperliquid',range:'02/15 → 03/15',uuid:rfull(),pct:23},
-  {id:'q1',num:'0403',strat:'Basis v1.0',status:'queued',tf:'15min',ex:'Binance',range:'03/01 → 03/31',uuid:rfull(),qpos:3},
-];
-
-const history=[];
-for(let i=0;i<35;i++){
-  const done=Math.random()>.15;const num=String(398-i).padStart(4,'0');
-  const pnl=done?Math.round((Math.random()-.3)*500000):0;
-  const dur=Math.floor(Math.random()*40+5);
-  const sharpe=done?(Math.random()*3-.5).toFixed(2):'—';
-  const winRate=done?(45+Math.random()*30).toFixed(1):'—';
-  const profitFactor=done?(0.5+Math.random()*2.5).toFixed(2):'—';
-  const maxDD=done?(-Math.random()*15-0.5).toFixed(1):'—';
-  const trades=done?Math.floor(Math.random()*2000+50):0;
-  const calmar=done?(Math.random()*4-.5).toFixed(2):'—';
-  history.push({
-    num:'BT-2026-'+num,strat:strats[i%strats.length],status:done?'done':'failed',
-    tf:tfs[i%tfs.length],ex:exs[i%exs.length],
-    range:(1+i%3).toString().padStart(2,'0')+'/01 → '+(1+i%3).toString().padStart(2,'0')+'/'+[28,31,15][i%3],
-    uuid:rfull(),pnl,dur:dur+'m '+Math.floor(Math.random()*60)+'s',
-    failMsg:done?'':['OOM @ 82%','Timeout','Data gap','Assertion error'][i%4],
-    sharpe,winRate,profitFactor,maxDD,trades,calmar,
-    id:'h'+i,
-  });
-}
-
-let curPage=1,pageSize=20;
-
