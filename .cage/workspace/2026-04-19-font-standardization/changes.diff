-/* === PROGRESS TICK === */
-const tasks={r1:{pct:67,speed:.4,total:1330000,elapsed:872},r2:{pct:23,speed:.25,total:8200000,elapsed:495}};
-function fmtT(s){const m=Math.floor(s/60),ss=Math.floor(s%60);return m+'m '+(ss<10?'0':'')+ss+'s'}
-function tickAll(){for(const[id,t]of Object.entries(tasks)){
-  t.pct+=t.speed+Math.random()*.3;t.elapsed+=2;if(t.pct>99)t.pct=15+Math.random()*10;
-  const p=Math.round(t.pct),proc=Math.round(t.total*t.pct/100),bps=Math.round(proc/t.elapsed),rem=(t.total-proc)/bps;
-  const el=s=>document.getElementById(s);
-  if(el('rbar-'+id))el('rbar-'+id).style.width=p+'%';
-  if(el('rpct-'+id))el('rpct-'+id).textContent=p+'%';
-  if(el('dbar-'+id))el('dbar-'+id).style.width=p+'%';
-  if(el('dpct-'+id))el('dpct-'+id).textContent=p+'%';
-  if(el('elap-'+id))el('elap-'+id).textContent=fmtT(t.elapsed);
-  if(el('eta-'+id))el('eta-'+id).textContent='~'+fmtT(rem);
-  if(el('spd-'+id))el('spd-'+id).textContent=bps.toLocaleString()+' bars/s';
-  if(el('proc-'+id))el('proc-'+id).textContent=(proc/1e6).toFixed(2)+'M / '+(t.total/1e6).toFixed(1)+'M';
-  if(el('trd-'+id)){const v=parseInt(el('trd-'+id).textContent.replace(/,/g,''));el('trd-'+id).textContent=(v+Math.floor(Math.random()*8)).toLocaleString()}
-}}
-setInterval(tickAll,2000);
