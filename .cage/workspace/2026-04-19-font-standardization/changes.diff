-.dtab{font-family:var(--font-d);font-size:.68rem;padding:.4rem .75rem;border-radius:4px;border:0;background:0;color:var(--t2);cursor:pointer;transition:all 150ms;white-space:nowrap;display:flex;align-items:center;gap:.35rem}.dtab:hover{color:var(--t1)}.dtab.a{background:var(--bg-t);color:var(--t0);box-shadow:0 1px 3px rgba(0,0,0,.12)}
-.tab-panel{display:none;animation:tpIn .3s var(--eo)}.tab-panel.active{display:block}
-@keyframes tpIn{from{opacity:0;transform:translateY(8px)}to{opacity:1;transform:translateY(0)}}
-
-/* Heatmap */
-.hm-grid{display:grid;gap:2px;font-family:var(--font-d);font-size:.58rem}
-.hm-label{padding:.25rem .35rem;color:var(--t2);text-align:center;display:flex;align-items:center;justify-content:center;font-size:.55rem}
-.hm-cell{padding:.3rem .2rem;text-align:center;border-radius:3px;font-weight:500;transition:transform 150ms;cursor:default}.hm-cell:hover{transform:scale(1.12);z-index:1}
-
-/* Waterfall */
-.wf-row{display:flex;align-items:center;gap:.5rem;padding:.4rem 0;font-family:var(--font-d);font-size:.72rem}
-.wf-label{width:80px;text-align:right;color:var(--t2);font-size:.68rem}
-.wf-bar-wrap{flex:1;height:20px;position:relative}.wf-bar{height:100%;border-radius:3px;transition:width .8s var(--eo)}
-.wf-val{font-weight:500;min-width:70px}
-
-/* Shuffle distribution */
-.shuffle-viz{position:relative;padding:1rem 0}
-
-/* View transitions */
-#viewExplorer,#viewReport{transition:opacity .35s var(--eo)}
-#viewExplorer.hide{display:none}
-#viewReport{display:none}#viewReport.show{display:flex;flex-direction:column;flex:1;overflow:hidden}
-
-/* Bar chart (horizontal) */
-.hbar{display:flex;align-items:center;gap:.5rem;padding:.25rem 0;font-family:var(--font-d);font-size:.68rem}
-.hbar-label{width:36px;text-align:right;color:var(--t2)}.hbar-wrap{flex:1;height:18px;background:var(--bg-t);border-radius:3px;overflow:hidden;position:relative}
-.hbar-fill{height:100%;border-radius:3px;transition:width .6s var(--eo)}.hbar-val{min-width:55px;font-weight:500}
-</style>
