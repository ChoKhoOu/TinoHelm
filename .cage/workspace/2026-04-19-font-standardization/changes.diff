-<script>
-// ── Page switching ──
-const pageMap = {
-  dashboard: 'Dashboard',
-  backtest:  '回测管理',
-  strategies:'策略管理',
-  trading:   '交易终端',
-  orders:    '订单',
-  watchlist: 'Watchlist',
-  analytics: 'Analytics',
-  optimization:'参数优化',
-};
-
-function switchPage(pageId, sidebarItem, tabBtn) {
-  // Hide all views
-  document.querySelectorAll('.page-view').forEach(v => v.classList.remove('active'));
-  const target = document.getElementById('page-' + pageId);
-  if (target) target.classList.add('active');
-
-  // Update sidebar active
-  document.querySelectorAll('.s-item').forEach(i => i.classList.remove('active'));
-  if (sidebarItem) {
-    sidebarItem.classList.add('active');
-  } else {
-    // Find sidebar item by title
-    const titles = { dashboard:'Dashboard', backtest:'回测管理', strategies:'策略管理', trading:'交易终端', orders:'订单', watchlist:'Watchlist', analytics:'Analytics', optimization:'优化' };
-    document.querySelectorAll('.s-item').forEach(i => {
-      if (i.getAttribute('title') === titles[pageId]) i.classList.add('active');
-    });
-  }
-
-  // Update tab active
-  document.querySelectorAll('.ptab').forEach(t => t.classList.remove('active'));
-  if (tabBtn) {
-    tabBtn.classList.add('active');
-  } else {
-    document.querySelectorAll('.ptab').forEach(t => {
-      if (t.textContent.trim() === (pageMap[pageId] || pageId)) t.classList.add('active');
-    });
-  }
-
-  // Update breadcrumb
-  document.getElementById('bcText').textContent = pageMap[pageId] || pageId;
-}
-
-// ── Retry button spinner ──
-function triggerRetry(btn) {
-  btn.classList.add('loading');
-  btn.disabled = true;
-  setTimeout(() => {
-    btn.classList.remove('loading');
-    btn.disabled = false;
-  }, 1500);
-}
-
-// ── Clear filters (demo) ──
-function clearFilters(btn) {
-  btn.classList.add('loading');
-  btn.disabled = true;
-  setTimeout(() => {
-    btn.classList.remove('loading');
-    btn.disabled = false;
-  }, 800);
-}
-
-// ── Clock ──
-function updateClock() {
-  const now = new Date();
-  const pad = n => String(n).padStart(2,'0');
-  document.getElementById('clock').textContent =
-    `${now.getFullYear()}-${pad(now.getMonth()+1)}-${pad(now.getDate())} ${pad(now.getHours())}:${pad(now.getMinutes())}:${pad(now.getSeconds())}`;
-}
-updateClock();
-setInterval(updateClock, 1000);
