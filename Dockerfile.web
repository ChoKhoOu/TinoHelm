# syntax=docker/dockerfile:1
# TinoHelm Web UI - Build Stage
FROM node:20-alpine AS builder

WORKDIR /app

# 1. Dependencies layer — only re-runs when package*.json changes
COPY src/web/package*.json ./
RUN --mount=type=cache,target=/root/.npm \
    npm ci

# 2. Config layer — rarely changes, avoids full rebuild on source edits
COPY src/web/next.config.ts src/web/tsconfig.json src/web/postcss.config.mjs src/web/components.json ./

# 3. Source layer — changes most often
COPY src/web/src/ ./src/
COPY src/web/public/ ./public/

# 4. Build with persistent Next.js cache
RUN --mount=type=cache,target=/app/.next/cache \
    npm run build

# Production Stage - nginx
FROM nginx:alpine

COPY --from=builder /app/out /usr/share/nginx/html
COPY nginx.conf /etc/nginx/conf.d/default.conf

EXPOSE 3000

HEALTHCHECK --interval=30s --timeout=5s --retries=3 \
    CMD curl -f http://localhost:3000/ || exit 1
