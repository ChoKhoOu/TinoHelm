# ---- Redis ----
REDIS_URL=redis://redis:6379/0

# ---- Trader / NT ----
TINO_TRADER_ID=TINO-001

# ---- Venue secrets (按需填写) ----
BINANCE_API_KEY=
BINANCE_API_SECRET=
BYBIT_API_KEY=
BYBIT_API_SECRET=

# ---- Discord ----
DISCORD_BOT_TOKEN=
DISCORD_GUILD_ID=
# 三个频道 id：sandbox 走纸面交易事件，live 走真实交易事件，
# logging 收 events.system.* / events.account.* / 每日总结这类
# 跨策略的运维消息（不会被拿去发 /pause 等控制命令）。
DISCORD_CHANNEL_ID_SANDBOX=
DISCORD_CHANNEL_ID_LIVE=
DISCORD_CHANNEL_ID_LOGGING=

# ---- Notifier ----
TINO_DAILY_SUMMARY_UTC=14:00       # 每日总结时间 (UTC)，例如 14:00 即北京时间 22:00
TINO_LOG_LEVEL=INFO
